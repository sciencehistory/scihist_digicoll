<%# Generated by Claude Code. Preview for manual testing in dev: http://localhost:3000/rails/view_components/bar_chart_component/ %>
<figure class="bar-chart" style="<%= style_for_chart %>">
  <% if caption.present? %>
    <figcaption class="bar-chart__caption"><%= caption %></figcaption>
  <% end %>
  <ul class="bar-chart__groups">
    <% groups.each do |group_label, values| %>
      <li class="bar-chart__group">
        <span class="bar-chart__group-label"><%= group_label %></span>
        <ul class="bar-chart__bars">
          <% series.each_with_index do |series_label, i| %>
            <li class="bar-chart__bar" style="<%= style_for_value(values[i]) %>">
              <span class="bar-chart__bar-label"><%= series_label %></span>
              <span class="bar-chart__bar-value"><%= display_value(values[i]) %></span>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</figure>
