<%# Generated by Claude Code. Preview for manual testing in dev: http://localhost:3000/rails/view_components/bar_chart_component/ %>
<figure class="bar-chart" style="<%= style_for_chart %>">
  <% if caption.present? || hint.present? %>
    <figcaption class="bar-chart__caption">
      <% if caption.present? %>
        <span class="bar-chart__caption-title"><%= caption %></span>
      <% end %>
      <% if hint.present? %>
        <span class="bar-chart__hint"><%= hint %></span>
      <% end %>
    </figcaption>
  <% end %>
  <ul class="bar-chart__groups">
    <% groups.each do |group_label, cells| %>
      <li class="bar-chart__group">
        <span class="bar-chart__group-label"><%= group_label %></span>
        <ul class="bar-chart__bars">
          <% series.each do |series_label| %>
            <% cell = cells[series_label] %>
            <li class="bar-chart__bar" style="<%= style_for_total(cell) %>">
              <span class="bar-chart__bar-label"><%= series_label %></span>
              <span class="bar-chart__bar-total" data-bs-toggle="tooltip" title="Total"><span class="visually-hidden">Total: </span><%= display_number(cell&.total) %></span>
              <span class="bar-chart__bar-current" data-bs-toggle="tooltip" title="Current"><span class="visually-hidden">Current: </span><%= display_number(cell&.current) %></span>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</figure>
