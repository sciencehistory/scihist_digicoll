<div class="card my-3">
  <h5 class="card-header">Automatic handwriting transcription</h5>

  <div class="card-body">
    <p><%= status_message %></p>

    <% if formatted_start_time %>
      <p>Started: <%= formatted_start_time %></p>
    <% end %>

    <% if transcription_request&.general_feedback.present? || transcription_request&.page_notes.present? %>
      <h6>Notes from Gemini</h6>

      <% if transcription_request.general_feedback.present? %>
        <p><%= transcription_request.general_feedback %></p>
      <% end %>

      <% if transcription_request.page_notes.present? %>
        <ul>
          <% transcription_request.page_notes.each do |friendlier_id, note| %>
            <li>
              <% if (asset = noted_assets[friendlier_id]) %>
                <%= link_to asset.title, admin_asset_path(asset) %>:
              <% else %>
                <%= friendlier_id %>:
              <% end %>
              <%= note %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% if eligibility_warning %>
      <p>
        <i class="fa fa-exclamation-triangle text-danger" aria-hidden="true"></i>
        <%= eligibility_warning %>
      </p>
    <% end %>

    <% if transcription_request&.success? %>
      <%= link_to "Go to transcript",
            work_path(work, anchor: "tab=handwriting-transcription"),
            class: "btn btn-outline-success" %>
    <% end %>

    <% if offer_new_request? %>
      <%= link_to "Request a new transcript",
            request_new_handwriting_transcription_admin_work_path(work),
            method: :post,
            class: "btn btn-outline-secondary #{'disabled' unless can?(:update, work)}",
            data: { confirm: new_request_confirm_message } %>
    <% end %>

    <% if offer_delete? %>
      <%= link_to "Delete transcript",
            delete_handwriting_transcription_admin_work_path(work),
            method: :delete,
            class: "btn btn-outline-danger #{'disabled' unless can?(:update, work)}",
            data: { confirm: "This will delete the transcript, and set the text extraction mode to none. Are you sure?" } %>
    <% end %>
  </div>
</div>
