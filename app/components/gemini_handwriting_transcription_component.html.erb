<% if ScihistDigicoll::Env.lookup(:gemini_htr_transcripts_feature_flag) %>
  <div class="card my-3">
    <h5 class="card-header">Automatic transcription of handwritten text</h5>

    <div class="card-body">
      <p class="h4 alert-heading"> </p>

      <% if current_request_status_message %>
        <p>
          <%= current_request_status_message %>
        </p>
      <% end %>



      <% if transcript_exists? %>
        <%= link_to("Go to transcript",
              transcript_link,
              class: "btn btn-outline-success my-3")
        %>
        <br />
      <% end %>

      <% if eligibility_problems.present? %>
        <%= "This work isn't eligible, as #{eligibility_problems.to_sentence}." %>
      <% elsif !request_pending? %>
        <%= link_to(request_button_label, admin_request_handwriting_transcription_path(work_id: work.friendlier_id), class: "btn btn-outline-secondary my-3") %>
      <% end %>
      <% if transcript_exists? %>
      <br />
      <%= link_to("Delete transcript",
              admin_delete_handwriting_transcription_path(work_id: work.friendlier_id),
              method: :delete,
              class: "btn btn-outline-danger my-3",
              data: { confirm: "Are you sure you want to delete this transcript?" }) %>
      <% end %>

      <p class="text-muted" role="alert">
        We're still working on this.
      </p>

      <!--
      <hr/>
      <p>Debug info (temporary):</p>
      <pre><%= transcript_request_json %><#/pre>
      -->
    </div>
  </div>
<% end %>


