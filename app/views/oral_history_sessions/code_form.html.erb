<div class="mb-4 text-page">
  <h2 class="brand-alt-h2 mb-4">Enter Your Sign-in Code</h2>

  <% if flash[:auto_link_message] %>
    <p class="alert alert-danger">
      <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
      <%= flash[:auto_link_message] %>
    </p>
  <% end %>

  <p>Enter the code we emailed to <b><%= @sign_in_code_email %></b>.</p>

  <%= render "code_form", return_to: safe_return_to(params[:return_to]) %>
</div>
