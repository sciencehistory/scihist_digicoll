<div class="admin-header sticky-top d-flex justify-content-between p-2 mb-4 mt-1 bg-light border">
  <h1 class="h5">Batch Replace Metadata <small>— <%= current_user.works_in_cart.count %> Works in Cart</small></h1>
</div>

<p class="text-muted">
  Find an exact value in a single Work metadata field, and replace it with a new value, across the
  <strong><%= pluralize(@form.cart_work_count, "Work") %></strong> currently in your Cart.
</p>

<% if @form.errors.any? %>
  <div class="alert alert-danger mb-4" role="alert">
    <ul class="mb-0">
      <% @form.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# batch_replace_form.js swaps old/new value text inputs for selects, using these lists

  in data-controlled-values we have options_for_select values for certain fields that
  aren't free entry but need a select box. JS in batch_replace_form.js will use.
-%>
<%= form_with url: admin_preview_batch_replace_metadata_path, method: :get, local: true,
      data: { controlled_values: Admin::BatchReplaceMetadataForm.controlled_values } do |f| %>
  <div class="row mb-3">
    <div class="col-md-4">
      <%= f.label :field_name, "Attribute", class: "form-label" %>
      <%= f.select :field_name,
            options_for_select(Admin::BatchReplaceMetadataForm.field_options, @form.field_name),
            { include_blank: "Select a field..." },
            { class: "form-select", required: true } %>
    </div>

    <div class="col-md-4">
      <%= f.label :old_value, "Old value (exact match)", class: "form-label" %>
      <%= f.text_field :old_value, value: @form.old_value, class: "form-control", required: true %>
    </div>

    <div class="col-md-4">
      <%= f.label :new_value, "New value", class: "form-label" %>
      <%= f.text_field :new_value, value: @form.new_value, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-actions d-flex justify-content-between">
    <%= link_to "Cancel", admin_cart_items_path, class: "btn btn-outline-secondary" %>
    <%= f.submit "Preview", class: "btn btn-primary" %>
  </div>
<% end %>
