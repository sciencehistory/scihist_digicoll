<%#
  OCR section of WorkAdminTextExtractInfoComponent: for a work in OCR mode, or with
  OCR-related leftovers from another mode.

  Locals: `component`, the WorkAdminTextExtractInfoComponent.
%>
<% if component.extra_ocr_warning? %>
  <p>
    <i class="fa fa-exclamation-triangle text-danger" aria-label="WARNING"></i> Text extraction mode is none, but some assets still have OCR text.
  </p>
<% end %>
<% if component.work_language_warning? %>
  <p>
    <i class="fa fa-exclamation-triangle text-danger" aria-label="WARNING"></i> OCR enabled, but work does not include languages
    compatible with OCR.
  </p>
  <ul>
    <li>Work languages: <code><%= component.work.language.inspect %></code></li>
    <li>OCR-compatible languages: <code><%= AssetOcrCreator::TESS_LANGS.keys %></code></li>
  </ul>
<% end %>
<p>
  <% if component.asset_ocr_count_warning? %>
    <i class="fa fa-exclamation-triangle text-danger" aria-label="WARNING"></i>
  <% end %>
  Out of <b><%= component.total_assets_count %></b> assets,
  <ul>
    <%# PDF roles don't belong in an OCR work, so are only listed if present %>
    <% if component.assets_with_source_pdf_role_count > 0 %>
      <li>
        <b><%= component.assets_with_source_pdf_role_count %></b> <%= 'asset'.pluralize(component.assets_with_source_pdf_role_count) %> with <code>role</code> <span class="badge text-bg-info"><%= PdfToPageImages::SOURCE_PDF_ROLE.humanize.downcase %></span>
      </li>
    <% end %>
    <% if component.assets_with_extracted_pdf_page_role_count > 0 %>
      <li>
        <b><%= component.assets_with_extracted_pdf_page_role_count %></b> <%= 'asset'.pluralize(component.assets_with_extracted_pdf_page_role_count) %> with <code>role</code> <span class="badge text-bg-info"><%= PdfToPageImages::EXTRACTED_PAGE_ROLE.humanize.downcase %></span>
      </li>
    <% end %>
    <li>
      <b><%= component.assets_with_ocr_count %></b>
      <%= 'asset'.pluralize(component.assets_with_ocr_count) %>
      currently
      <%= (component.assets_with_ocr_count == 1) ? 'has' : 'have' %>
      extracted <code>hocr</code> text
    </li>
    <% if component.assets_with_ocr_suppressed_count > 0 %>
      <li>
        <b><%=  component.assets_with_ocr_suppressed_count %></b> <%= 'asset'.pluralize(component.assets_with_ocr_suppressed_count) %> <%= (component.assets_with_ocr_suppressed_count == 1) ? 'has' : 'have' %> OCR suppressed.
      </li>
    <% end %>
  </ul>
</p>
